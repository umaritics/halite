# Neo4j AuraDB (get from aura.neo4j.io free tier)
# For local dev: use bolt://localhost:7687 with docker-compose.yml neo4j service
# For VM/demo: point at shared Aura instance
# WARNING: Aura free auto-pauses when idle — wake and verify the day BEFORE the defense
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Groq API (get from console.groq.com — free tier)
# Required for conflict engine and evaluation harness (T5, T7)
# Without this, GROQ is in demo/fallback mode and conflict engine refuses to run
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gitea (self-hosted on remote VM)
GITEA_BASE_URL=
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=

# App
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
MAX_UPLOAD_MB=10

# Maintenance domain settings
# Confidence threshold for auto-accepting conflict detections.
# PROVISIONAL — must be re-calibrated after running evaluate_conflict_detection.py
MAINT_CONFIDENCE_THRESHOLD=0.72
# Base data directory (relative to backend/); raw/ and processed/ are beneath it
MAINT_DATA_DIR=data
# Maximum number of prior records to compare against per conflict check
MAINT_MAX_CANDIDATES=25
