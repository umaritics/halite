# Neo4j AuraDB (get from aura.neo4j.io free tier)
# For local host + docker Neo4j: bolt://localhost:7687
# docker compose backend overrides this to bolt://neo4j:7687 automatically
# For VM/demo: point at shared Aura instance
# WARNING: Aura free auto-pauses when idle — wake and verify the day BEFORE the defense
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Groq API (get from console.groq.com — free tier)
# Required when LLM_PROVIDER=groq (default for local dev)
# Without a live provider, conflict engine refuses to run (allow_stub=False on staging paths)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local / VM Ollama (optional — staging uses this instead of Groq for bulk conflict analysis)
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=http://halite-ollama:11434/v1
# OPENAI_COMPAT_API_KEY=  # must match OLLAMA_API_KEY in docker-compose.vm.yml root .env
# GROQ_MODEL=qwen3:4b   # Ollama tag when provider is openai_compatible (see docs/local-llm-staging.md)
# LLM_REQUEST_TIMEOUT_S=120
# OLLAMA_API_KEY=       # set in repo-root .env beside compose (not committed); chmod 600

# Application-layer API authentication (REQUIRED when DEMO_MODE=false; fail-closed 503 if unset)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send: Authorization: Bearer <HALITE_API_KEY>  (or alias X-Halite-Api-Key: <HALITE_API_KEY>)
HALITE_API_KEY=

# Privileged operator secret (set a separate long random value on the VM only; never ship to browsers)
# Required for GET /api/ops/logs, DELETE /api/graph/reset, POST /api/maintenance/analysis/run
# Header: X-Ops-Token: <OPS_TOKEN>
OPS_TOKEN=

# Public surface & browser CORS controls
SECRET_KEY=change-me-in-production-min-32-random-chars
# Optional separate JWT signing secret (defaults to SECRET_KEY)
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Relational database for Workspace Identity, RBAC, Sessions & Audit Trail (M01)
# Docker Compose / VM Postgres: postgresql://halite:<POSTGRES_PASSWORD>@postgres:5432/halite
# Or any Supabase PostgreSQL connection string. Leave empty in local DEMO_MODE=true for in-memory SQLite.
POSTGRES_PASSWORD=
DATABASE_URL=

# Optional idempotent initial admin bootstrap (used on first VM / Compose boot; never commit real passwords)
BOOTSTRAP_ORG_NAME=Halite Maintenance Operations
BOOTSTRAP_ORG_SLUG=halite-ops
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Halite Administrator

FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins (e.g. https://halite.curatech.pk)
CORS_ALLOWED_ORIGINS=
# Regex restricted to Halite's own Vercel preview/prod URLs (set empty to disable regex matching)
CORS_ORIGIN_REGEX=^https://halite(?:-[a-z0-9-]+)?\.vercel\.app$
DEMO_MODE=true
# Omit or set false on public deployments (disables /docs, /redoc, /openapi.json)
EXPOSE_OPENAPI=
MAX_UPLOAD_MB=10

# In-process sliding-window rate limits (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=180
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=20

# Deprecated Gitea integration (retired Nov 2026 — routes return 410 Gone unless true)
ENABLE_GITEA_INTEGRATION=false
GITEA_BASE_URL=
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=

# Injected by deploy pipeline (optional locally)
GIT_SHA=unknown
DEPLOYED_AT=

# Maintenance domain settings
# Confidence threshold for auto-accepting conflict detections.
# PROVISIONAL — must be re-calibrated after running evaluate_conflict_detection.py
MAINT_CONFIDENCE_THRESHOLD=0.50
# Base data directory (relative to backend/); raw/ and processed/ are beneath it
MAINT_DATA_DIR=data
MAINT_ANALYSIS_MODE=legacy
MAINT_DAILY_REQUEST_LIMIT=1000
MAINT_DAILY_TOKEN_LIMIT=200000
MAINT_BUDGET_UTILIZATION=0.90
MAINT_BUDGET_TOKEN_RESERVE=1000
# MAINT_BUDGET_STATE_FILE=data/analysis_budget.json
# Maximum number of prior records to compare against per conflict check
MAINT_MAX_CANDIDATES=25
