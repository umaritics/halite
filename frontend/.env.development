# Loaded automatically by Vite during `npm run dev`.
# Team default: shared staging API (not localhost).
# Put `VITE_HALITE_API_KEY=<team-key>` in gitignored `frontend/.env.local` (never commit secrets).
# Override locally in `frontend/.env.development.local` if you need a local backend
# (plain `.env.local` does not work: Vite lets this mode file win over it):
#   VITE_API_URL=/api
#   VITE_PROXY_TARGET=http://localhost:8000
VITE_API_URL=https://dev1.corp.curatech.pk/halite-api/api
