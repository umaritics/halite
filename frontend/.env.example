# Team Mid-I default is versioned in `.env.development` (loaded by `npm run dev`).
# This file is documentation / Vercel template only — Vite does NOT load `.env.example`.
#
# Guide: docs/security-public-deployment.md
#        knowledge/context/modules/remote_backend.md
#
# Shared staging API:
VITE_API_URL=https://dev1.corp.curatech.pk/halite-api/api
#
# Required for protected /api/* routes on shared staging / production.
# Set in gitignored `frontend/.env.local` locally and in Vercel Project Settings -> Environment Variables.
# NEVER commit a real API key.
VITE_HALITE_API_KEY=
#
# Optional local backend override -> create gitignored `.env.local`:
# VITE_API_URL=/api
# VITE_PROXY_TARGET=http://localhost:8000
# VITE_HALITE_API_KEY=halite-local-dev-api-key
