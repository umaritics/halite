# Copy to .env.local for local overrides, or set in Vercel Project Settings → Environment Variables
#
# Team default: use the SHARED staging API (not localhost) so everyone hits the same backend.
# Guide: knowledge/context/modules/remote_backend.md
#
# Leave empty (or /api) only when you intentionally want the Vite proxy → local :8000
VITE_API_URL=https://dev1.corp.curatech.pk/halite-api/api

# Optional: if you leave VITE_API_URL empty, Vite proxies /api to this target
# VITE_PROXY_TARGET=http://localhost:8000
